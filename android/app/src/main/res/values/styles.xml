<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:editTextBackground">@android:color/transparent</item>
    </style>

    <!--
        Matches the JS splash colour exactly, so there is no flash between the two.
        Below API 31 there is no system splash, so the window background carries the
        icon itself. See values-v31 for the newer devices, where the system draws the
        icon and this window must be a plain colour or it appears twice.
    -->
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
