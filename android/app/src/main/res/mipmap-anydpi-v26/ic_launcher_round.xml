<?xml version="1.0" encoding="utf-8"?>
<!--
    The artwork is a finished icon in its own right: a rounded square with its own
    blue gradient. So it goes in as the background, full bleed, and the launcher's
    mask crops it to whatever shape the device uses. Splitting it into a flat colour
    plus a foreground was not an option — the blue runs from #038DF9 at the top to
    #0026A5 at the bottom, and no single colour sits behind that without a seam.

    The foreground is therefore empty. The monochrome layer still points at the old
    vector, which is line art and is the only one of the three that themed icons can
    actually use.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
